<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.potatotv.pacc</groupId>
    <artifactId>ptv-backend</artifactId>
    <version>5.4.0</version>
    <name>PACC PTV 管控后端</name>
    <description>PACC v5.0 PTV 管控层：账号 / 检测 / AI 评分 / 红屏广播 / 远程查端 / 记录 / 特征库 / 统计</description>

    <properties>
        <java.version>21</java.version>
        <jmh.version>1.37</jmh.version>
        <!-- PBP 自研二进制协议运行时，版本独立于 PACC（1.0.0），不参与 scripts/bump-version.sh 的整体升版 -->
        <pacc.pbp.version>1.0.0</pacc.pbp.version>
        <!-- PRL 自研规则语言运行时，版本同样独立于 PACC；bump-version.sh 只做一致性断言，不改它 -->
        <pacc.prl.version>1.0.0</pacc.prl.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 健康检查（容器编排探针） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Swagger / OpenAPI 3.0（在线调试；默认仅 local 开启，生产经 PACC_SPRINGDOC_ENABLED 显式开启） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.9.1</version>
        </dependency>

        <!-- 邮件（密码找回真实发送；对公上线必须配置真实 SMTP） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Flyway：版本化数据库迁移（表结构由迁移脚本管理，生产 ddl-auto=validate） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- Prometheus 指标暴露（监控栈） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- 运行库：演示用 H2；生产可替换 MySQL 8.0 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Argon2id 密码哈希：自研 PA2（com.potatotv.pa2，零第三方依赖，仅用 JDK 标准库），
             源码随本模块提供，运行时不再引入 BouncyCastle bcprov。 -->
        <!-- 测试作用域保留 BouncyCastle，仅用于生成基准向量，校验 PA2 逐字节一致（验收 V01/V02） -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.86</version>
            <scope>test</scope>
        </dependency>

        <!-- JMH：PA2 与 BouncyCastle 性能基准（测试作用域，不进运行时依赖） -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 自研规则语言（PRL）：动态检测规则由 rules/*.prl 提供，替代原先的 LuaJ。
             PRL 运行时零第三方依赖，规则在自研 VM 上执行，宿主能力经 PrlHostContext 白名单暴露。 -->
        <dependency>
            <groupId>com.potatotv</groupId>
            <artifactId>pacc-rule-language</artifactId>
            <version>${pacc.prl.version}</version>
        </dependency>

        <!-- 自研二进制协议（PBP）：WSS 信令信封拼装/解析；消息定义见 pacc-binary-protocol/mdl/pacc_wire.mdl，
             类型 com.potatotv.pbp.gen.PaccEnvelope 由 tools/pbpgen 生成后入库。零第三方依赖。 -->
        <dependency>
            <groupId>com.potatotv</groupId>
            <artifactId>pacc-binary-protocol</artifactId>
            <version>${pacc.pbp.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- 保留方法参数名，供 Spring 反射解析 @RequestParam/@PathVariable 等（否则未显式命名的参数运行时 400） -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- JaCoCo 覆盖率：prepare-agent 挂在 initialize，report 挂在 test 之后。
                 因此 `mvn package` 一次就能同时产出 surefire 报告与 site/jacoco/，
                 CI 直接取产物，不需要额外跑一遍 test（重复跑会拖慢构建）。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>