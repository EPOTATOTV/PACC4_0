# ============================================================
# PACC v4.0 PTV 系统部署环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env（Windows: copy .env.example .env）
# docker compose 会自动加载根目录 .env 文件
# ============================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=pacc-root-change-me
MYSQL_DATABASE=pacc
MYSQL_USER=pacc
MYSQL_PASSWORD=pacc-secret-change-me

# ---- PTV 后端 ----
# 对公发布为 fail-closed：以下密钥不在本文件提供默认值，必须自行替换为强随机值后填写。
# 任一缺失或仍用演示弱值，后端会在启动阶段直接报错拒绝运行。
# 管理后台 API Key（前端登录使用；同一值也转发给 Go 边缘网关）
PACC_ADMIN_API_KEY=
# 超级管理员授权 Key（权限高于运维 Key）
PACC_SECURITY_SUPER_ADMIN_KEY=
# JWT 签名密钥（>=32 字节）
PACC_SECURITY_JWT_SECRET=
# 玩家端 WSS 上报签名密钥（>=16 字节，须与玩家端 PACC_CLIENT_WSS_SECRET 一致）
PACC_SECURITY_WSS_SIGN_SECRET=
# 是否预置演示数据（生产务必 false）
PACC_SEED=false
# 红屏触发阈值（综合风险分）
PACC_REDSCREEN_THRESHOLD=85

# ---- 密码找回邮件（生产必填；未配置 SMTP 时找回功能不发送） ----
PACC_MAIL_STUB_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# 重置邮件里的门户基地址（对公发布必须为公网可访问地址）
PACC_MAIL_RESET_BASE_URL=https://pacc.potatotv.asia

# ---- 管理员飞书登录（可选，默认关闭）----
# 启用后默认拒绝所有飞书用户，须把其 open_id / 邮箱 / 手机号加入下面白名单才放行
# 说明：open_id 最稳；邮箱/手机号需应用开通对应通讯录权限后由登录日志返回
PACC_FEISHU_ENABLED=false
PACC_FEISHU_APP_ID=
PACC_FEISHU_APP_SECRET=
PACC_FEISHU_SUPER_ADMIN_USERIDS=
PACC_FEISHU_ADMIN_USERIDS=

# ---- 端口映射（可修改）----
PACC_BACKEND_PORT=8080
PACC_FRONTEND_PORT=8081
PACC_MYSQL_PORT=3306
# Go 边缘网关（限流 + 鉴权 + 指标）
PACC_GO_GATEWAY_PORT=8090
# AI 推理服务
PACC_AI_PORT=8000
# 监控栈（--profile monitoring 启用）
PACC_PROMETHEUS_PORT=9090
PACC_GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=pacc-grafana-change-me

# ---- 域名网关（生产：PotatoTV 四个子域名）----
# 网关在 nginx.conf 中按域名分流，无需在此配置域名；
# 若需启用 HTTPS，将证书放入 deploy/gateway/certs/ 后重建网关即可。
# 默认端口 80/443（如被占用可修改映射）：
PACC_GATEWAY_HTTP_PORT=80
PACC_GATEWAY_HTTPS_PORT=443
