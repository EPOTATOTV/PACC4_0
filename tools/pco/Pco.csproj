<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 刻意用 net8.0 而不是 net8.0-windows：这个工具只读写 PE/元数据，不碰 WPF，
         这样在 Linux CI 上也能编译与跑测试。 -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pco</AssemblyName>
    <RootNamespace>PaccManager.Pco</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- 默认的 **/*.cs 通配会把 tests/ 下的自测源码也编进来（两个 Main，直接编译失败）。 -->
    <Compile Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 自测项目直接用内部类型（AssemblyRenamer / PcoRules / StringHeapMap），不为了测试去开 public API。 -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Pco.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>