<Application x:Class="PaccManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 深色主题：与 PACC 后台风格一致 -->
        <SolidColorBrush x:Key="Bg" Color="#0D1117" />
        <SolidColorBrush x:Key="Panel" Color="#161B22" />
        <SolidColorBrush x:Key="Border" Color="#30363D" />
        <SolidColorBrush x:Key="Text" Color="#E6EDF3" />
        <SolidColorBrush x:Key="Muted" Color="#8B949E" />
        <SolidColorBrush x:Key="Accent" Color="#58A6FF" />
        <SolidColorBrush x:Key="Danger" Color="#FF3B30" />
        <SolidColorBrush x:Key="Ok" Color="#3FB950" />
    </Application.Resources>
</Application>