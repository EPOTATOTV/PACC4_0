<Window x:Class="PaccManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PACC v4.0 Windows 管理工具"
        Width="860" Height="600" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Microsoft YaHei UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}">
                PACC Windows 客户端管理工具</TextBlock>
            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Muted}"
                       Text="安装程序 GUI · 配置管理 · 诊断工具（v4.0）"/>
        </StackPanel>

        <!-- 主标签页 -->
        <TabControl Grid.Row="2" Margin="0,12,0,0" Background="{StaticResource Panel}">
            <!-- =================== 安装 =================== -->
            <TabItem Header="安装">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Foreground="{StaticResource Accent}"
                                   Text="环境自检（点击下方按钮执行）"/>
                        <TextBox x:Name="InstallCheckBox" IsReadOnly="True" AcceptsReturn="True"
                                 Height="120" Margin="0,8,0,0" FontFamily="Consolas"
                                 Background="{StaticResource Panel}" Foreground="{StaticResource Text}"
                                 BorderBrush="{StaticResource Border}" VerticalScrollBarVisibility="Auto"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="RunInstallCheckBtn" Content="环境自检" Padding="16,6"
                                    Click="OnRunInstallCheck" Background="{StaticResource Accent}"
                                    Foreground="{StaticResource Bg}" FontWeight="Bold"/>
                            <Button x:Name="InstallPaccBtn" Content="一键安装 / 修复 PACC 服务" Padding="16,6"
                                    Margin="12,0,0,0" Click="OnInstallPacc"
                                    Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}"/>
                        </StackPanel>
                        <TextBlock FontWeight="Bold" Foreground="{StaticResource Accent}"
                                   Margin="0,16,0,6" Text="说明"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                   Text="安装将完成：1) 校验管理员权限与 x86-64 架构；2) 将 ptv-client 与底层检测注入模块安装为系统服务；3) 生成默认 pacc-client.properties；4) 校验数据中心/域名的连通性。卸载需在「配置」页删除本工具。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =================== 配置 =================== -->
            <TabItem Header="配置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" Text="客户端配置"/>
                            <TextBlock DockPanel.Dock="Right" x:Name="ConfigPathText"
                                       Foreground="{StaticResource Muted}" FontSize="11" TextAlignment="Right"/>
                        </DockPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,0,8,10"/>
                                </Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Margin" Value="0,0,8,10"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="Background" Value="{StaticResource Panel}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                                </Style>
                            </Grid.Resources>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="玩家长连接 / WSS 入口"/>
                            <TextBox x:Name="CfgEndpoint" Grid.Row="0" Grid.Column="1"/>
                            <TextBlock x:Name="EndpointProbe" Grid.Row="0" Grid.Column="2"
                                       Foreground="{StaticResource Muted}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="REST API 基址"/>
                            <TextBox x:Name="CfgApiBase" Grid.Row="1" Grid.Column="1"/>
                            <TextBlock x:Name="ApiBaseProbe" Grid.Row="1" Grid.Column="2"
                                       Foreground="{StaticResource Muted}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="红屏触发阈值"/>
                            <TextBox x:Name="CfgThreshold" Grid.Row="2" Grid.Column="1"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="0-100" Foreground="{StaticResource Muted}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="上报采样率"/>
                            <TextBox x:Name="CfgSampleRate" Grid.Row="3" Grid.Column="1"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="0-1" Foreground="{StaticResource Muted}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="日志级别"/>
                            <TextBox x:Name="CfgLogLevel" Grid.Row="4" Grid.Column="1"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="自动登录 PTEID"/>
                            <TextBox x:Name="CfgPteid" Grid.Row="5" Grid.Column="1"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="LoadCfgBtn" Content="加载" Padding="16,6"
                                    Click="OnLoadConfig"/>
                            <Button x:Name="SaveCfgBtn" Content="保存" Padding="16,6"
                                    Margin="10,0,0,0" Click="OnSaveConfig"
                                    Background="{StaticResource Accent}" Foreground="{StaticResource Bg}"/>
                            <Button x:Name="TestCfgBtn" Content="测试连接" Padding="16,6"
                                    Margin="10,0,0,0" Click="OnTestConfig"/>
                        </StackPanel>

                        <TextBlock x:Name="ConfigStatus" Margin="0,10,0,0"
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =================== 诊断 =================== -->
            <TabItem Header="诊断">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                        <Button x:Name="DiagNetBtn" Content="重新检测网络 / 端点" Padding="16,6"
                                Click="OnDiagNetwork"/>
                        <Button x:Name="DiagCopyBtn" Content="复制报告" Padding="16,6"
                                Margin="10,0,0,0" Click="OnCopyReport"/>
                    </StackPanel>
                    <TextBox x:Name="DiagnosticBox" Grid.Row="1" IsReadOnly="True"
                             Margin="0,10,0,0" AcceptsReturn="True" FontFamily="Consolas"
                             Background="{StaticResource Panel}" Foreground="{StaticResource Text}"
                             BorderBrush="{StaticResource Border}" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="3" Background="{StaticResource Panel}"
                   BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Text="就绪"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>