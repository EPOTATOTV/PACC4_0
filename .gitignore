.settings/*
!.settings/org.eclipse.jdt.core.prefs
.project
.classpath

# --- OS ---
Thumbs.db
.DS_Store

# --- Logs & data ---
*.log
logs/
*.sqlite
*.db
application-local.yml
# 环境变量/真实密钥：一律不入库，仅保留 .env.example 模板
.env
.env.*
!.env.example

# --- Evidence / runtime ---
/evidence/
/data/

# --- Local dev toolchain (downloaded Maven/Node) ---
/.tools/
/tools-local/

