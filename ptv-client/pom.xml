<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.potatotv.pacc</groupId>
    <artifactId>ptv-client</artifactId>
    <version>5.4.0</version>
    <name>PACC 玩家端用户态服务</name>
    <description>PACC v5.0 玩家端检测层：本地检测引擎、WSS 上报、红屏接收。</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <!-- 发行产物加固：默认开启。本地需要可读产物调试时用 -Dpacc.pob.skip=true 跳过。 -->
        <pacc.pob.skip>false</pacc.pob.skip>
        <!-- POB 自研字节码混淆器，版本独立于 PACC（1.0.0），不参与 scripts/bump-version.sh 的整体升版 -->
        <pacc.pob.version>1.0.0</pacc.pob.version>
        <!-- PBP 自研二进制协议运行时，版本独立于 PACC（1.0.0），不参与 scripts/bump-version.sh 的整体升版 -->
        <pacc.pbp.version>1.0.0</pacc.pbp.version>
        <!-- PRL 自研规则语言运行时，版本同样独立于 PACC；bump-version.sh 只做一致性断言，不改它 -->
        <pacc.prl.version>1.0.0</pacc.prl.version>
    </properties>

    <!-- 玩家端运行时依赖：只有自研二进制协议（WSS 查端信令信封，定义见 pacc-binary-protocol/mdl/pacc_wire.mdl），
         它本身零第三方依赖。不引入任何游戏服务器相关依赖；检测/传输核心仍用 JDK（java.net.http + TLS 1.3）。 -->
    <dependencies>
        <dependency>
            <groupId>com.potatotv</groupId>
            <artifactId>pacc-binary-protocol</artifactId>
            <version>${pacc.pbp.version}</version>
        </dependency>
        <!-- 自研规则语言（PRL）：24 条端侧检测规则改为 rules/*.prl，在自研 VM 上解释执行。
             与 PBP 一样零第三方依赖、且只用到 java.base，所以不会给混淆配置带来新的 libraryjars。 -->
        <dependency>
            <groupId>com.potatotv</groupId>
            <artifactId>pacc-rule-language</artifactId>
            <version>${pacc.prl.version}</version>
        </dependency>
        <!-- 自研跨平台更新核心（PCU）。它与 PACC 同版本、不做独立协议版本，所以这里直接跟随
             ${project.version}：bump-version.sh 改一次版本号，两边同时对齐，不需要再多一个版本字段。
             它同样零第三方依赖，会被 POB 一并并入发行件并被拍平重命名。 -->
        <dependency>
            <groupId>com.potatotv</groupId>
            <artifactId>pacc-cross-platform-updater</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.4</version>
            <scope>test</scope>
        </dependency>
        <!-- 构建期工具（自研字节码混淆器），不参与运行：用 test scope 是为了让它只出现在
             exec:java 的 test classpath 上，同时被 copy-dependencies(includeScope=compile) 排除，
             不会跟着 PBP/PRL/PCU 一起被并进发行 jar。
             与 PBP/PRL/PCU 一样，需要先在 tools/pob 执行 mvn install。 -->
        <dependency>
            <groupId>com.potatotv</groupId>
            <artifactId>pacc-obfuscator</artifactId>
            <version>${pacc.pob.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <!-- 强制每次 package 都从 classes 重建 jar：
                         POB 是「原地」加固（injar == outjar），若 jar 插件因时间戳判定跳过重建，
                         下一轮 package 就会把上一轮已混淆的 jar 再喂给 POB，造成二次混淆
                         （短名被再改一次、映射表错乱）。开发机上跑不带 clean 的
                         mvn package 时尤其容易踩到。 -->
                    <forceCreation>true</forceCreation>
                    <archive>
                        <manifest>
                            <mainClass>com.potatotv.paccclient.PaccClient</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- 发行产物加固（P0）：打包后立即用自研 POB 混淆器对自有字节码 + 并入依赖做重命名与包拍平。
                 必须声明在 maven-jar-plugin 之后，保证以已生成的 jar 作为输入。

                 两步分工：
                   1) copy-dependencies 把编译期依赖拷到 target/pob-merge，作为 POB 的合并输入；
                   2) exec:java 跑 pacc-obfuscator，原地改写 target/&lt;finalName&gt;.jar。

                 为什么依赖必须并进产物：发布件是单 jar（installer.iss 只装一个文件），而依赖默认
                 只参与编译、不进 jar。此前 protobuf 依赖就是这样漏掉的——PaccWire 进了产物、
                 它依赖的 GeneratedMessageV3 没进，二进制信封路径运行时直接 NoClassDefFoundError，
                 CI 的 jdeps 门禁也会报一堆 not found。依赖只剩零依赖、无反射的 PBP/PRL/PCU 运行时，
                 并进来后随拍平一起被重命名。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>collect-dependencies-for-pob</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <skip>${pacc.pob.skip}</skip>
                            <includeScope>compile</includeScope>
                            <outputDirectory>${project.build.directory}/pob-merge</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <executions>
                    <execution>
                        <id>obfuscate-release-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <skip>${pacc.pob.skip}</skip>
                            <mainClass>com.potatotv.pob.PobMain</mainClass>
                            <!-- 混淆器是 test scope 的项目依赖；exec:java 默认只看 runtime classpath -->
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>--in</argument>
                                <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                                <argument>--merge</argument>
                                <argument>${project.build.directory}/pob-merge</argument>
                                <argument>--rules</argument>
                                <argument>${project.basedir}/pob-rules.pob</argument>
                                <argument>--mapping</argument>
                                <argument>${project.build.directory}/pob-mapping.txt</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- ======================================================================
         opt-in：构建期字符串加密（设计文档 3.2.3）
         默认关闭！原因：它需要 platform/string-protect 先 install 到本地仓库
         （mvn -f platform/string-protect/pom.xml install），CI 只单独构建 ptv-client、
         并不预先安装该模块。放在默认链上会让 CI 因解析不到依赖而变红；
         且生成的 PaccSecretStrings 目前没有源码调用点（消费方改造是后续源码变更），
         默认链上多出一个死类没有收益。故以属性开关显式启用，零风险。

         启用方式：
           1) mvn -B -f platform/string-protect/pom.xml install
           2) cd ptv-client && mvn -B -Dpacc.stringprotect.enabled=true package
         步骤 2 会生成 com.potatotv.paccclient.protect.PaccSecretStrings（密文端点/密钥键），
         它由 pob-rules.pob 末尾的 keep 规则固定名字。
         ====================================================================== -->
    <profiles>
        <profile>
            <id>string-protect</id>
            <activation>
                <property>
                    <name>pacc.stringprotect.enabled</name>
                    <value>true</value>
                </property>
            </activation>

            <dependencies>
                <dependency>
                    <groupId>com.potatotv.pacc</groupId>
                    <artifactId>string-protect</artifactId>
                    <version>5.4.0</version>
                </dependency>
            </dependencies>

            <build>
                <plugins>
                    <!-- 声明顺序即同阶段执行顺序：先把生成源码目录挂进编译源根，再跑生成器，
                         之后的 compile 阶段才能看到 PaccSecretStrings.java。 -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.2</version>
                        <executions>
                            <execution>
                                <id>add-generated-protect-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>${project.build.directory}/generated-sources/pacc-protect</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.4</version>
                        <executions>
                            <execution>
                                <id>generate-secret-strings</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>com.potatotv.pacc.protect.StringProtectorGenerator</mainClass>
                                    <arguments>
                                        <!-- 参数：<outFile> <package> <class> <key> <literal>... -->
                                        <argument>${project.build.directory}/generated-sources/pacc-protect/com/potatotv/paccclient/protect/PaccSecretStrings.java</argument>
                                        <argument>com.potatotv.paccclient.protect</argument>
                                        <argument>PaccSecretStrings</argument>
                                        <argument>0x5AC3</argument>
                                        <!-- 敏感字面量：WSS / API 端点 + 命名密钥键（与 build-client.ps1 写入的键一致） -->
                                        <argument>wss://pacc.potatotv.asia/ws/ptv</argument>
                                        <argument>https://api.potatotv.asia</argument>
                                        <argument>pacc.client.wss.sign.secret</argument>
                                        <argument>pacc.client.signature.secret</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>