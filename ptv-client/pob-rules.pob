# PACC 玩家端（ptv-client）发行产物加固配置——POB 自研字节码混淆器
#
# 本文件是 proguard-rules.pro 的等价替换：POB 做重命名（类名/成员名/字符串内类名）与包拍平，
# 不做收缩（shrink）与优化（optimize）。字符串加密 / Unicode 命名 / 垃圾代码 / 完整性校验 /
# 控制流平坦化是可选变换，当前发行口径已全部启用（见文件末尾的开关段）。
# 因此下面只保留「必须原样留下」的 keep 集合。
#
# 与 CI 的三条硬约束（.github/workflows/ci.yml）绑定，改动前务必对齐：
#   a) com/potatotv/paccclient/PaccClient.class 必须存在（唯一对外入口契约）
#   b) 产物中不得再出现 com/potatotv/paccclient/{detection,transport,signature,store,ops,probe}/
#   c) 必须存在 com/potatotv/paccclient/<1~3 字符>.class 短名混淆类（Unicode 命名后是私有区字符）
#
# 语法：keep class <点分类名> [name|public|all] / keep member <点分类名> <成员名>
#   name   —— 只固定类名，成员名照常混淆（缺省级别）
#   public —— 固定类名 + public/protected 成员名
#   all    —— 固定类名 + 全部成员名
# ---------------------------------------------------------------------------

# 入口：唯一对外契约，必须保留原名，且 main 的名字不能被改（JVM 按名启动）。
keep class com.potatotv.paccclient.PaccClient
keep member com.potatotv.paccclient.PaccClient main

# HookDetector 通过 Class.forName 校验「关键类是否被影子类前置」，它引用的类名以字符串
# 常量形式出现（security/HookDetector.java 的 CRITICAL_CLASSES）：
#   com.potatotv.paccclient.Json / PaccClient / detection.DetectionEngine
# Json 与 PaccClient 在本文件里固定了名字，字符串天然命中；DetectionEngine 不固定名称，
# 由 POB 的字符串同步改写（等价 ProGuard 的 -adaptclassstrings）把该字符串换成新类名，
# 于是 Class.forName 仍装载到同一类，且 detection/ 包不再残留在产物中（约束 b）。
# 切勿给它加 keep：一旦固定名字，重打包失效，约束 b 直接失败。
keep class com.potatotv.paccclient.Json all

# ---------------------------------------------------------------------------
# v5.4 APM / 安全模块：只固定「反射引用」与「跨模块/后续由检测引擎按名调用」的最小集合，
# 不使用整包 keep（那会连带保留内部实现类，抵消拍平效果）。
# ---------------------------------------------------------------------------

# DetectionMetrics.SINK 由检测引擎（后续接入）按名调用；ApmCollector / ClientHealthMetrics
# 是外部按名引用的入口，重命名会导致后续集成断链。
keep class com.potatotv.paccclient.apm.ApmCollector public
keep class com.potatotv.paccclient.apm.DetectionMetrics$Sink public
keep class com.potatotv.paccclient.apm.ClientHealthMetrics public

# 安全上报入口与其函数式接口：由 PaccClient 以外的地方（测试/后续原生层）按名调用
keep class com.potatotv.paccclient.security.SecurityReporter public
keep class com.potatotv.paccclient.security.SecurityReporter$BatchSink all
keep class com.potatotv.paccclient.security.SecurityReporter$AttestationTransport all
keep class com.potatotv.paccclient.security.SecurityReporter$Challenge all

# ---------------------------------------------------------------------------
# 字符串加密（platform/string-protect）产物：仅当以 -Dpacc.stringprotect.enabled=true
# 打开 opt-in profile 时，构建会生成 com.potatotv.paccclient.protect.PaccSecretStrings。
# 它当前无源码引用，POB 不做收缩因而不会删类；固定名字是为了消费方按名引用它时不断链。
# 默认构建下该规则无匹配对象。
# ---------------------------------------------------------------------------
keep class com.potatotv.paccclient.protect.PaccSecretStrings public

# ---------------------------------------------------------------------------
# 二进制协议（PBP）/ 规则语言（PRL）/ 更新核心（PCU）运行时与生成类不设任何 keep：
# 它们零依赖、无反射（无 Class.forName / ServiceLoader），随包拍平一起被重命名。
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 强化变换开关。当前发布口径已全部启用；任何一项若在验证门禁上出问题，
# 改回 false 重新打包即可回退，不必动混淆器代码。逐项含义：
#
# encrypt_strings：ldc String -> ldc_w int + PobVault.get(I)，需注入解密库类；
#   会跳过类名/描述符样串、被注解/字段常量引用的串、白名单串与短串。
# encrypt_strings_keep：白名单，列出的字符串保持明文（逗号或引号分隔）。
#   JVM / 系统属性名与编解码器名不能动，否则 System.getProperty / Charset.forName 会失配。
# unicode_names：短名改用 Unicode 私有区字符；CI 的短名断言已同步放宽容忍度，
#   若第三方工具（反编译器 / 性能分析器）无法处理，可单独改回 false 用 ASCII 短名。
# bogus_code / integrity：只对 enhance class 标记的类生效。
# flatten：控制流平坦化，保守子集——逐方法判定，带异常表 / 原生 switch / 栈非空入口等
#   无法安全重建 StackMapTable 的方法原样放行（见 tools/pob ControlFlowFlattener）。
# ---------------------------------------------------------------------------
encrypt_strings = true
encrypt_strings_min_length = 4
encrypt_strings_keep = "java.version","os.name","UTF-8"
unicode_names = true
bogus_code = true
integrity = true
flatten = true

# 垃圾代码 / 完整性校验的目标类：检测与反调试核心。完整性校验在类的 <clinit> 入口比对
# 自身字节的 SHA-256，不符即抛异常自毁；因此这里只放「随发行件一同更新、不会独立改动」的类，
# 绝不放会被规则热更新替换的配置/规则载体。
enhance class com.potatotv.paccclient.detection.DetectionEngine
enhance class com.potatotv.paccclient.security.HookDetector
enhance class com.potatotv.paccclient.security.AntiDebugService