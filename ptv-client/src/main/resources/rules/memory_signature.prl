# memory_signature：内存特征码命中（用户态扫描，需探针可用）
# 文档 §4.3 / §6.1 内存注入类

rule "memory_signature" {
    version: "1.0.0"
    author: "PACC Security Team"
    severity: high
    category: "memory"
    description: "内存特征码：用户态内存扫描命中已知作弊代码特征"
    enabled: true
    cooldown: 0s

    input {
        features: map[string, float]
    }

    let supported = features["ext_memory_supported"] ?? 0.0
    let hits = features["ext_memory_signature_hits"] ?? 0.0
    let score = features["ext_memory_score"] ?? 0.0

    # [] 与 ["x"] 在 if 的两个分支里类型不统一，用 take(x, 0) 造一个带类型的空 list[string]
    let no_keys = take([""], 0)
    let keys = (if hits > 0.0: ["ext_memory_signature_hits"] else: no_keys end)

    # 探针不可用时 supported=0，直接不判定；避免把「扫不了」当成「没作弊」
    when:
        supported >= 1.0 AND hits > 0.0

    then:
        emit_alert(
            type = "memory_signature",
            confidence = score / 100.0,
            evidence = {
                "score": score,
                "keys": keys
            }
        )
}