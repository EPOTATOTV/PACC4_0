# cheat_registry_trace：注册表痕迹（作弊软件键 / 驱动服务键）
# 文档 §4.5 / §6.1 系统痕迹类

rule "cheat_registry_trace" {
    version: "1.0.0"
    author: "PACC Security Team"
    severity: high
    category: "system"
    description: "注册表痕迹：命中作弊软件注册表键或可疑驱动服务键"
    enabled: true
    cooldown: 0s

    input {
        features: map[string, float]
    }

    let score = features["ext_registry_score"] ?? 0.0

    # [] 与 ["x"] 在 if 的两个分支里类型不统一，用 take(x, 0) 造一个带类型的空 list[string]
    let no_keys = take([""], 0)
    let keys = (if score >= 20.0: ["ext_registry_score"] else: no_keys end)

    # 只读白名单键名，不读键值内容；单项权重 10-50，阈值 20 要求至少两项或高权重项
    when:
        score >= 20.0

    then:
        emit_alert(
            type = "cheat_registry_trace",
            confidence = score / 100.0,
            evidence = {
                "score": score,
                "keys": keys
            }
        )
}