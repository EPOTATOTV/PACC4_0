# sprint：冲刺违规（急转后仍保持冲刺，OmniSprint）
# 对应检测 cheat/rules/SprintRule

rule "sprint" {
    version: "1.0.0"
    author: "PACC Security Team"
    severity: medium
    category: "cheat"
    description: "冲刺违规：急转后仍保持冲刺"
    enabled: true

    input {
        features: map[string, float]
    }

    let violations = features["feature_omnisprint_violations"] ?? 0.0
    let consistency = features["feature_sprint_consistency"] ?? 0.0

    let score = min([40.0 + violations * 5.0, 65.0])
        + (if consistency >= 0.99: 12.0 else: 0.0 end)

    # [] 与 ["x"] 在 if 的两个分支里类型不统一，用 take(x, 0) 造一个带类型的空 list[string]
    let no_keys = take([""], 0)
    let keys = ["feature_omnisprint_violations"]
        + (if consistency >= 0.99: ["feature_sprint_consistency"] else: no_keys end)

    when:
        violations > 0.0

    then:
        emit_alert(
            type = "sprint",
            confidence = score / 100.0,
            evidence = {
                "score": score,
                "keys": keys
            }
        )
}