# nuker：范围破坏（单 tick 破坏方块的覆盖半径超出原版限制）
# 对应检测 cheat/rules/NukerRule

rule "nuker" {
    version: "1.0.0"
    author: "PACC Security Team"
    severity: medium
    category: "cheat"
    description: "范围破坏：单 tick 覆盖半径超出原版限制"
    enabled: true

    input {
        features: map[string, float]
    }

    let radius = features["feature_nuker_break_radius"] ?? 0.0
    let busy = features["feature_fastbreak_block_per_sec"] ?? 0.0

    let score = 45.0
        + (if radius >= 5.0: 25.0 else: 0.0 end)
        + (if busy >= 5.0: 20.0 else: 0.0 end)

    # [] 与 ["x"] 在 if 的两个分支里类型不统一，用 take(x, 0) 造一个带类型的空 list[string]
    let no_keys = take([""], 0)
    let keys = ["feature_nuker_break_radius"]
        + (if busy >= 5.0: ["feature_fastbreak_block_per_sec"] else: no_keys end)

    when:
        radius >= 2.5

    then:
        emit_alert(
            type = "nuker",
            confidence = score / 100.0,
            evidence = {
                "score": score,
                "keys": keys
            }
        )
}