# cheststealer：快速箱子（每秒取物数远超人手上限）
# 对应检测 cheat/rules/ChestStealerRule

rule "cheststealer" {
    version: "1.0.0"
    author: "PACC Security Team"
    severity: medium
    category: "cheat"
    description: "快速箱子：每秒取物数远超人手上限"
    enabled: true

    input {
        features: map[string, float]
    }

    let per_sec = features["feature_cheststealer_items_per_sec"] ?? 0.0

    let score = min([40.0 + (per_sec - 5.0) * 4.0, 85.0])

    let keys = ["feature_cheststealer_items_per_sec"]

    when:
        per_sec > 5.0

    then:
        emit_alert(
            type = "cheststealer",
            confidence = score / 100.0,
            evidence = {
                "score": score,
                "keys": keys
            }
        )
}