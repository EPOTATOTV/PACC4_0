# ifeo_hijack：IFEO 镜像劫持 / AppInit_DLLs 全局注入（高危）
# 文档 §4.5 / §6.1 系统痕迹类

rule "ifeo_hijack" {
    version: "1.0.0"
    author: "PACC Security Team"
    severity: critical
    category: "system"
    description: "镜像劫持：Image File Execution Options 或 AppInit_DLLs 被写入作弊载荷"
    enabled: true
    cooldown: 0s

    input {
        features: map[string, float]
    }

    let ifeo = features["ext_registry_ifeo_hits"] ?? 0.0
    let score = features["ext_registry_score"] ?? 0.0

    # [] 与 ["x"] 在 if 的两个分支里类型不统一，用 take(x, 0) 造一个带类型的空 list[string]
    let no_keys = take([""], 0)
    let keys = (if ifeo > 0.0: ["ext_registry_ifeo_hits"] else: no_keys end)

    # IFEO/AppInit_DLLs 被劫持是明确的注入证据，命中即判定
    when:
        ifeo > 0.0

    then:
        emit_alert(
            type = "ifeo_hijack",
            confidence = score / 100.0,
            evidence = {
                "score": score,
                "keys": keys
            }
        )
}