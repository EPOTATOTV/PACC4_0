# debugger_present：调试器挂载（jdwp/agentlib、javaagent、硬件断点）
# 文档 §6.1 系统级类

rule "debugger_present" {
    version: "1.0.0"
    author: "PACC Security Team"
    severity: medium
    category: "system"
    description: "调试器挂载：进程带 jdwp/agentlib，或挂了 javaagent"
    enabled: true
    cooldown: 0s

    input {
        features: map[string, float]
    }

    let debug = features["feature_debugger_present"] ?? 0.0
    let agent = features["feature_jvm_agent_attached"] ?? 0.0
    let bp = features["feature_hardware_breakpoint_count"] ?? 0.0

    let score = 45.0
        + (if debug >= 1.0: 30.0 else: 0.0 end)
        + (if agent >= 1.0: 25.0 else: 0.0 end)
        + (if bp > 0.0: 20.0 else: 0.0 end)

    # [] 与 ["x"] 在 if 的两个分支里类型不统一，用 take(x, 0) 造一个带类型的空 list[string]
    let no_keys = take([""], 0)
    let keys = (if debug >= 1.0: ["feature_debugger_present"] else: no_keys end)
        + (if agent >= 1.0: ["feature_jvm_agent_attached"] else: no_keys end)
        + (if bp > 0.0: ["feature_hardware_breakpoint_count"] else: no_keys end)

    when:
        debug >= 1.0 OR agent >= 1.0 OR bp > 0.0

    then:
        emit_alert(
            type = "debugger_present",
            confidence = score / 100.0,
            evidence = {
                "score": score,
                "keys": keys
            }
        )
}