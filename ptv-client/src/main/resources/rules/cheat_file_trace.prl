# cheat_file_trace：作弊软件文件痕迹（安装路径 / 作弊 mod 文件）
# 文档 §4.4 / §6.1 系统痕迹类

rule "cheat_file_trace" {
    version: "1.0.0"
    author: "PACC Security Team"
    severity: high
    category: "system"
    description: "作弊文件痕迹：白名单路径扫描命中作弊软件安装目录或作弊 mod 文件"
    enabled: true
    cooldown: 0s

    input {
        features: map[string, float]
    }

    let trace = features["ext_file_trace_hits"] ?? 0.0
    let mods = features["ext_file_mod_hits"] ?? 0.0
    let score = features["ext_file_score"] ?? 0.0

    # [] 与 ["x"] 在 if 的两个分支里类型不统一，用 take(x, 0) 造一个带类型的空 list[string]
    let no_keys = take([""], 0)
    let keys = (if trace > 0.0: ["ext_file_trace_hits"] else: no_keys end)
        + (if mods > 0.0: ["ext_file_mod_hits"] else: no_keys end)

    # 只扫描白名单路径（不读文件内容），单条 mod 文件权重 40 >= 阈值 25
    when:
        (trace > 0.0 OR mods > 0.0) AND score >= 25.0

    then:
        emit_alert(
            type = "cheat_file_trace",
            confidence = score / 100.0,
            evidence = {
                "score": score,
                "keys": keys
            }
        )
}