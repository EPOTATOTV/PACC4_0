# scaffold：搭路（放置频率 + 潜行一致性 + 视角俯角）
# 对应检测 cheat/rules/ScaffoldRule

rule "scaffold" {
    version: "1.0.0"
    author: "PACC Security Team"
    severity: medium
    category: "cheat"
    description: "搭路：放置频率偏高、不潜行或视角锁定俯角"
    enabled: true

    input {
        features: map[string, float]
    }

    let per_sec = features["feature_scaffold_block_per_sec"] ?? 0.0
    let sneak = features["feature_scaffold_sneak_consistency"] ?? 0.0
    let pitch = features["feature_scaffold_pitch_angle"] ?? 0.0

    let score = (if per_sec >= 3.0: 35.0 else: 0.0 end)
        + (if per_sec >= 6.0: 15.0 else: 0.0 end)
        + (if sneak < 0.6: 30.0 else: 0.0 end)
        + (if pitch >= 75.0: 20.0 else: 0.0 end)

    # [] 与 ["x"] 在 if 的两个分支里类型不统一，用 take(x, 0) 造一个带类型的空 list[string]
    let no_keys = take([""], 0)
    let keys = (if per_sec >= 3.0: ["feature_scaffold_block_per_sec"] else: no_keys end)
        + (if sneak < 0.6: ["feature_scaffold_sneak_consistency"] else: no_keys end)
        + (if pitch >= 75.0: ["feature_scaffold_pitch_angle"] else: no_keys end)

    when:
        per_sec >= 1.0 AND score >= 40.0

    then:
        emit_alert(
            type = "scaffold",
            confidence = score / 100.0,
            evidence = {
                "score": score,
                "keys": keys
            }
        )
}