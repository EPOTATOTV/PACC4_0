# known_cheat_module：已知作弊模块注入（模块名直接命中，高置信）
# 文档 §4.2 / §6.1 内存注入类

rule "known_cheat_module" {
    version: "1.0.0"
    author: "PACC Security Team"
    severity: critical
    category: "memory"
    description: "已知作弊模块：Minecraft 进程加载了已知作弊 DLL/模块"
    enabled: true
    cooldown: 0s

    input {
        features: map[string, float]
    }

    let hits = features["ext_module_known_cheat_hits"] ?? 0.0
    let base = features["ext_module_score"] ?? 0.0
    # 模块名白名单命中属于强证据，即使分值维度缺失也按 90 计，避免 confidence 为 0
    let score = (if hits > 0.0 AND base < 90.0: 90.0 else: base end)

    # [] 与 ["x"] 在 if 的两个分支里类型不统一，用 take(x, 0) 造一个带类型的空 list[string]
    let no_keys = take([""], 0)
    let keys = (if hits > 0.0: ["ext_module_known_cheat_hits"] else: no_keys end)

    when:
        hits > 0.0

    then:
        emit_alert(
            type = "known_cheat_module",
            confidence = score / 100.0,
            evidence = {
                "score": score,
                "keys": keys
            }
        )
}