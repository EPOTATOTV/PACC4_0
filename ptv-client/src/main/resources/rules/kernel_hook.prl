# kernel_hook：内核钩子与驱动异常（SSDT 改写 + 无签名内核驱动）
# 文档 §6.1 系统级类

rule "kernel_hook" {
    version: "1.0.0"
    author: "PACC Security Team"
    severity: medium
    category: "system"
    description: "内核钩子与驱动异常：SSDT 被改写或无签名内核驱动"
    enabled: true
    cooldown: 0s

    input {
        features: map[string, float]
    }

    let ssdt = features["feature_ssdt_hooks"] ?? 0.0
    let drivers = features["feature_unknown_kernel_drivers"] ?? 0.0

    let score = 45.0
        + (if ssdt > 0.0: min([ssdt * 10.0, 30.0]) else: 0.0 end)
        + (if drivers > 0.0: min([drivers * 5.0, 20.0]) else: 0.0 end)

    # [] 与 ["x"] 在 if 的两个分支里类型不统一，用 take(x, 0) 造一个带类型的空 list[string]
    let no_keys = take([""], 0)
    let keys = (if ssdt > 0.0: ["feature_ssdt_hooks"] else: no_keys end)
        + (if drivers > 0.0: ["feature_unknown_kernel_drivers"] else: no_keys end)

    when:
        (ssdt > 0.0 OR drivers > 0.0) AND score >= 40.0

    then:
        emit_alert(
            type = "kernel_hook",
            confidence = score / 100.0,
            evidence = {
                "score": score,
                "keys": keys
            }
        )
}