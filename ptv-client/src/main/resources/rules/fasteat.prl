# fasteat：快速进食（进食动画时长被压缩 + 进食间隔机械规整）
# 对应检测 cheat/rules/FastEatRule

rule "fasteat" {
    version: "1.0.0"
    author: "PACC Security Team"
    severity: medium
    category: "cheat"
    description: "快速进食：进食动画时长被压缩"
    enabled: true

    input {
        features: map[string, float]
    }

    let duration = features["feature_fasteat_duration_mean"] ?? 0.0
    let interval_cv = features["feature_fasteat_interval_cv"] ?? 0.0

    let score = min([45.0 + (1400.0 - duration) / 100.0, 75.0])
        + (if duration < 800.0: 20.0 else: 0.0 end)
        + (if interval_cv > 0.0 AND interval_cv < 0.15: 20.0 else: 0.0 end)

    # [] 与 ["x"] 在 if 的两个分支里类型不统一，用 take(x, 0) 造一个带类型的空 list[string]
    let no_keys = take([""], 0)
    let keys = ["feature_fasteat_duration_mean"]
        + (if interval_cv > 0.0 AND interval_cv < 0.15: ["feature_fasteat_interval_cv"] else: no_keys end)

    when:
        duration > 0.0 AND duration < 1400.0

    then:
        emit_alert(
            type = "fasteat",
            confidence = score / 100.0,
            evidence = {
                "score": score,
                "keys": keys
            }
        )
}