# fastbreak：快速破坏（破坏速率超限 + 挥臂动画波动极低）
# 对应检测 cheat/rules/FastBreakRule

rule "fastbreak" {
    version: "1.0.0"
    author: "PACC Security Team"
    severity: medium
    category: "cheat"
    description: "快速破坏：每秒破坏方块数超限且挥臂动画呈机械节拍"
    enabled: true

    input {
        features: map[string, float]
    }

    let per_sec = features["feature_fastbreak_block_per_sec"] ?? 0.0
    let anim_cv = features["feature_swing_animation_cv"] ?? 0.0

    let score = 45.0
        + (if per_sec >= 5.0: 25.0 else: 0.0 end)
        + (if anim_cv > 0.0 AND anim_cv < 0.1: 20.0 else: 0.0 end)

    # [] 与 ["x"] 在 if 的两个分支里类型不统一，用 take(x, 0) 造一个带类型的空 list[string]
    let no_keys = take([""], 0)
    let keys = ["feature_fastbreak_block_per_sec"]
        + (if anim_cv > 0.0 AND anim_cv < 0.1: ["feature_swing_animation_cv"] else: no_keys end)

    when:
        per_sec >= 3.0

    then:
        emit_alert(
            type = "fastbreak",
            confidence = score / 100.0,
            evidence = {
                "score": score,
                "keys": keys
            }
        )
}