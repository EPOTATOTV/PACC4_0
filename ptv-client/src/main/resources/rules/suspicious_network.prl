# suspicious_network：异常网络行为（C2 通信 / 异常端口 / 游戏进程非标准连接）
# 文档 §4.8 / §6.1 系统类

rule "suspicious_network" {
    version: "1.0.0"
    author: "PACC Security Team"
    severity: medium
    category: "network"
    description: "异常网络行为：命中作弊软件 C2 域名或异常出站端口"
    enabled: true
    cooldown: 0s

    input {
        features: map[string, float]
    }

    let c2 = features["ext_network_c2_hits"] ?? 0.0
    let ports = features["ext_network_suspicious_port_hits"] ?? 0.0
    let mc = features["ext_network_mc_nonstandard_hits"] ?? 0.0
    let score = features["ext_network_score"] ?? 0.0

    # [] 与 ["x"] 在 if 的两个分支里类型不统一，用 take(x, 0) 造一个带类型的空 list[string]
    let no_keys = take([""], 0)
    let keys = (if c2 > 0.0: ["ext_network_c2_hits"] else: no_keys end)
        + (if ports > 0.0: ["ext_network_suspicious_port_hits"] else: no_keys end)
        + (if mc > 0.0: ["ext_network_mc_nonstandard_hits"] else: no_keys end)

    # 仅本地连接表只读采样；C2/异常端口需达到加权阈值，非标准连接需累积多条
    when:
        score >= 40.0 AND (c2 > 0.0 OR ports > 0.0)

    then:
        emit_alert(
            type = "suspicious_network",
            confidence = score / 100.0,
            evidence = {
                "score": score,
                "keys": keys
            }
        )
}