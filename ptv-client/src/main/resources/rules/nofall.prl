# nofall：无坠落伤害（超过 3 格却未受伤的次数 + 虚空滞留）
# 对应检测 cheat/rules/NoFallRule

rule "nofall" {
    version: "1.0.0"
    author: "PACC Security Team"
    severity: medium
    category: "cheat"
    description: "无坠落伤害：超过原版下限坠落后未受伤"
    enabled: true

    input {
        features: map[string, float]
    }

    let violations = features["feature_nofall_violations"] ?? 0.0
    let void_hits = features["feature_nofall_void"] ?? 0.0
    let void_time = features["feature_void_time"] ?? 0.0

    let score = (if violations > 0.0: min([45.0 + violations * 10.0, 70.0]) else: 0.0 end)
        + (if void_hits > 0.0: 30.0 else: 0.0 end)
        + (if void_time > 1.0: 10.0 else: 0.0 end)

    # [] 与 ["x"] 在 if 的两个分支里类型不统一，用 take(x, 0) 造一个带类型的空 list[string]
    let no_keys = take([""], 0)
    let keys = (if violations > 0.0: ["feature_nofall_violations"] else: no_keys end)
        + (if void_hits > 0.0: ["feature_nofall_void"] else: no_keys end)

    when:
        violations > 0.0 OR void_hits > 0.0

    then:
        emit_alert(
            type = "nofall",
            confidence = score / 100.0,
            evidence = {
                "score": score,
                "keys": keys
            }
        )
}